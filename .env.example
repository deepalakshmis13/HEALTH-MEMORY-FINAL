# ---------------------------------------------------------------------------
# Elder Health Memory — environment configuration
#
# Copy to backend/.env (or export these in your shell) before running uvicorn.
# Every value below has a working default: the application runs with no
# configuration at all.
# ---------------------------------------------------------------------------

# --- Security --------------------------------------------------------------
# CHANGE THIS before running anywhere but your own machine.
SECRET_KEY=dev-only-change-me-elder-health-memory
TOKEN_TTL_SECONDS=43200
MAX_UPLOAD_BYTES=15728640

# --- Database (MongoDB) ----------------------------------------------------
# The application stores everything in MongoDB. Point MONGODB_URI at a local
# server, a replica set, or an Atlas cluster. Credentials belong here in your
# own .env file (which is git-ignored) — never in committed source.
#   mongodb://localhost:27017
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=health_memory
MONGODB_TIMEOUT_MS=3000

# If MONGODB_URI cannot be reached, fall back to a local file-backed store so a
# fresh checkout still runs. Set this to 0 in production so a misconfigured URI
# fails loudly instead of quietly writing somewhere else.
MONGODB_LOCAL_FALLBACK=1
MONGODB_LOCAL_PATH=./.mongo-local

STORAGE_DIR=./storage

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- CONFIDENCE THRESHOLDS -------------------------------------------------
# The single place the verification routing rule is tuned.
#   confidence >= HIGH   -> accepted straight into health memory
#   MEDIUM..HIGH         -> "Needs Verification"        (reviewer, normal)
#   < MEDIUM             -> "High Priority Verification" (reviewer, urgent)
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60

# --- RAG -------------------------------------------------------------------
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=8
RAG_RECENCY_HALFLIFE_DAYS=120
EMBEDDING_DIM=256

# --- AI provider -----------------------------------------------------------
# auto : use the hosted model if LLM_API_KEY is set, otherwise MockAIProvider
# mock : always use the deterministic grounded provider
# llm  : always call the hosted model (falls back to the grounded draft on error)
AI_PROVIDER=auto
# LLM_API_KEY=sk-ant-...
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-5

# --- Frontend --------------------------------------------------------------
# Only needed if the API is not behind the Vite dev proxy.
# VITE_API_BASE=http://127.0.0.1:8000
